{
  "version": "v15",
  "wcag_target": "2.2 AA-inspired checklist",
  "principles": [
    "perceptível",
    "operável",
    "compreensível",
    "robusto"
  ],
  "requirements": [
    "navegação completa por teclado",
    "foco visível",
    "contraste suficiente",
    "alternativa textual para imagens",
    "legendas/transcrições para vídeos",
    "redução de movimento",
    "sem conteúdo que dependa apenas de cor",
    "tamanho de fonte ajustável",
    "alvos de toque confortáveis",
    "estado de carregamento compreensível",
    "mensagens de erro acionáveis"
  ],
  "performance_budget": {
    "initial_js_kb_gzip_target": 250,
    "initial_image_kb_target": 450,
    "hero_video_autoplay": "never_by_default",
    "webgl": "progressive_enhancement",
    "maps": "lazy_after_intent_or_below_fold",
    "third_party_scripts": "defer_until_needed",
    "offline": "app_shell_plus_recent_content"
  },
  "metrics": [
    "LCP",
    "INP",
    "CLS",
    "JS_long_tasks",
    "image_decode_time",
    "memory_pressure"
  ],
  "motion_policy": "nenhuma animação deve ser necessária para completar uma tarefa."
}