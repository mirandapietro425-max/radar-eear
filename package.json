{
  "name": "radar-eear",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test:runtime": "node --experimental-strip-types scripts/runtime-smoke.mjs && node --experimental-strip-types scripts/validate-v54-global.mjs",
    "validate": "node --experimental-strip-types scripts/validate-v54-global.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:runtime && npm run test:e2e",
    "test:assistant": "node scripts/assistant-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
